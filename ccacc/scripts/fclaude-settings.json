{
  "theme": "custom:fclaude",
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8686",
    "ANTHROPIC_AUTH_TOKEN": "ccacc-local",
    "ANTHROPIC_MODEL": "claude-sonnet-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-sonnet-5-5",
    "ANTHROPIC_SMALL_FAST_MODEL": "claude-haiku-5-5"
  },
  "statusLine": { "type": "command", "command": "bun C:/user/Apps/cmdtools/fclaude-status.ts" },
  "hooks": {
    "Stop": [
      { "hooks": [ { "type": "command", "command": "ccacc stop-gate", "timeout": 10 } ] }
    ]
  }
}
