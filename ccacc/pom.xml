<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.ccsuite</groupId>
    <artifactId>ccsuite-ccacc</artifactId>
    <version>0.1.0-beta.3</version>
    <packaging>jar</packaging>
    <description>ccacc, the Claude Code accounts tool, one resident app for the Claude Code line: account watcher (cswap), usage widget and taskbar card (ccu) and the local proxy (ccls), with one tray icon and menu.</description>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>25.0.2</javafx.version>
        <mainClass>ccsuite.ccacc.CcaccMain</mainClass>
        <!-- the jar the exe runs: the one just built, or -Dccacc.jar=<a stable place> for the exe that is kept -->
        <ccacc.jarname>ccacc</ccacc.jarname>
        <ccacc.jar>${project.build.directory}/${ccacc.jarname}.jar</ccacc.jar>
        <!-- where a release lives and where installed copies look for the next one (the site repo's update/ccacc.json); channel stable or beta -->
        <jrexe.release>https://github.com/ccsuite/ccsuite/releases/download/v${project.version}</jrexe.release>
        <jrexe.updates>https://ccsuite.github.io/update</jrexe.updates>
        <jrexe.channel>stable</jrexe.channel>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.ccsuite</groupId>
            <artifactId>ccsuite-oauthswap</artifactId>
            <version>1.0</version>
            <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>io.github.ccsuite</groupId>
            <artifactId>ccsuite-usagetracker</artifactId>
            <version>1.0</version>
            <!-- JavaFX comes from this pom only, with the classifier of the platform being built (-Djavafx.platform=...) -->
            <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>io.github.ccsuite</groupId>
            <artifactId>ccsuite-ccgate</artifactId>
            <version>1.0</version>
            <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>io.github.ccsuite</groupId>
            <artifactId>ccsuite-localserver</artifactId>
            <version>1.0</version>
            <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>

        <!-- install, uninstall and update of the exe itself, as every jr app has them -->
        <dependency>
            <groupId>io.github.jarrunner</groupId>
            <artifactId>jr-apputils</artifactId>
            <version>1.1</version>
            <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>

        <!-- The frame every gate window is built in (band in the app colour, glow, keys swallowed until the window has settled) -->
        <dependency>
            <groupId>io.github.leasegate</groupId>
            <artifactId>leasegate-frame</artifactId>
            <version>0.2.1</version>
            <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>

        <!-- The tray icon whose menu is drawn by JavaFX (the leasegate apps use it too) -->
        <dependency>
            <groupId>io.github.leasegate</groupId>
            <artifactId>leasegate-tray</artifactId>
            <version>0.2</version>
            <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>


        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.38</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.15.2</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- One jar per platform, because JavaFX carries its natives per platform. Same scheme as cfucli's bundle:
             openjfx's own -Djavafx.platform hook does not work under Maven 4, so each target names its classifier here.
             With no profile named the build machine's own natives are used (host-platform) and the jar is target/ccacc.jar;
             a named target gets its own jar name, so a cross-build never overwrites the local one.
               mvn -Pmac-aarch64 package    Apple silicon         mvn -Pmac package    Intel Mac         mvn -Pwin package    Windows x64 -->
        <profile>
            <id>host-platform</id>
            <activation><activeByDefault>true</activeByDefault></activation>
            <dependencies>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-base</artifactId>
                    <version>${javafx.version}</version>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                    <version>${javafx.version}</version>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-fxml</artifactId>
                    <version>${javafx.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>win</id>
            <properties><ccacc.jarname>ccacc-win</ccacc.jarname></properties>
            <dependencies>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-base</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-fxml</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>win</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>mac</id>
            <properties><ccacc.jarname>ccacc-mac</ccacc.jarname><jr.platforms>macos</jr.platforms><jr.macosArchitecture>x86_64</jr.macosArchitecture></properties>
            <dependencies>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-base</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>mac</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>mac</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>mac</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-fxml</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>mac</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>mac-aarch64</id>
            <properties><ccacc.jarname>ccacc-mac-aarch64</ccacc.jarname><jr.platforms>macos</jr.platforms><jr.macosArchitecture>arm64</jr.macosArchitecture></properties>
            <dependencies>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-base</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>mac-aarch64</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>mac-aarch64</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>mac-aarch64</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-fxml</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>mac-aarch64</classifier>
                    <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions>
                </dependency>
            </dependencies>
        </profile>

        <!-- mvn -Pwin,release-windows -Djrexe -Djr.source=url verify: the Windows exe and the whole release folder, Mac jars included (build them first: -Pmac-aarch64 package, -Pmac package) -->
        <profile>
            <id>release-windows</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.github.jarrunner</groupId>
                        <artifactId>jr-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>ccacc</id>
                                <configuration>
                                    <releaseFiles>
                                        <releaseFile>${project.build.directory}/ccacc-mac.jar</releaseFile>
                                        <releaseFile>${project.build.directory}/ccacc-mac-aarch64.jar</releaseFile>
                                    </releaseFiles>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- The cmdtools launcher, built by jr-maven-plugin with the config baked in:
             mvn -Djrexe -Djr.installDir=<folder on PATH> package -->
        <profile>
            <id>jrexe</id>
            <activation><property><name>jrexe</name></property></activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.github.jarrunner</groupId>
                        <artifactId>jr-maven-plugin</artifactId>
                        <version>1.3.0</version>
                        <executions>
                            <execution>
                                <id>ccacc</id>
                                <!-- verify, not package: in package the exe would be built before this module's own shade and hash the previous jar -->
                                <phase>verify</phase>
                                <goals><goal>exe</goal></goals>
                                <configuration>
                                    <name>ccacc</name>
                                    <jar>${ccacc.jar}</jar>
                                    <appId>io.github.ccsuite:ccacc</appId>
                                    <jarUrl>${jrexe.release}/${ccacc.jarname}-{sha8}.jar</jarUrl>
                                    <updateUrl>${jrexe.updates}/ccacc.json</updateUrl>
                                    <updateChannel>${jrexe.channel}</updateChannel>
                                    <icon>${project.basedir}/pkg/ccacc.ico</icon>
                                    <productName>ccacc</productName>
                                    <companyName>ccsuite</companyName>
                                    <copyright>ccsuite contributors</copyright>
                                    <javaVersion>25+</javaVersion>
                                    <jvmMode>dll</jvmMode>
                                    <!-- Tray/UI app flags from the resident-apps guideline; Xmx is for the three parts in one process, to be measured (prp/35). -->
                                    <vmArgs><vmArg>-Xms16m</vmArg><vmArg>-Xmx256m</vmArg><vmArg>-Xss512k</vmArg><vmArg>-XX:+UseSerialGC</vmArg><vmArg>-XX:MinHeapFreeRatio=10</vmArg><vmArg>-XX:MaxHeapFreeRatio=30</vmArg><vmArg>-XX:TieredStopAtLevel=1</vmArg><vmArg>-XX:MaxMetaspaceSize=192m</vmArg><vmArg>-XX:ReservedCodeCacheSize=64m</vmArg><vmArg>-XX:MaxDirectMemorySize=32m</vmArg><vmArg>--enable-native-access=ALL-UNNAMED</vmArg></vmArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.38</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>${ccacc.jarname}</finalName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${mainClass}</mainClass>
                                    <manifestEntries>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
